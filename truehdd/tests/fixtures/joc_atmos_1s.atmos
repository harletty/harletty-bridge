version: 0.5.1
presentations:
  - type: home
    simplified: false
    metadata: out.atmos.metadata
    audio: out.atmos.audio
    offset: 0.0
    fps: 24
    scBedConfiguration: [3]
    creationTool: truehdd
    creationToolVersion: {VERSION}
    sourceCodec: EAC3-JOC
    bedInstances:
      - channels:
          - channel: LFE
            ID: 3
    objects:
      - ID: 10
      - ID: 11
      - ID: 12
      - ID: 13
      - ID: 14
      - ID: 15
      - ID: 16
      - ID: 17
      - ID: 18
      - ID: 19
      - ID: 20
      - ID: 21
      - ID: 22
      - ID: 23
      - ID: 24
